{
  "id": "host.tetragon",
  "title": "Tetragon host observations",
  "adapter": "tetragon",
  "enabled": true,
  "queues": [
    "network.egress"
  ],
  "max_age_ms": 30000,
  "coverage": "Selected credential-file opens and unusual executions only. Open attempts do not prove successful reads; normal executions are not in this log.",
  "capabilities": {
    "host.sensitive_file_open": {
      "type": "object",
      "fields": {
        "process": {
          "type": "object",
          "fields": {
            "pid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            },
            "path": {
              "type": "string",
              "max_len": 1024
            },
            "exec_id": {
              "type": "string",
              "max_len": 512
            },
            "start_time": {
              "type": "string",
              "max_len": 64
            },
            "uid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            }
          },
          "required": [
            "pid",
            "path"
          ]
        },
        "parent": {
          "type": "object",
          "fields": {
            "pid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            },
            "path": {
              "type": "string",
              "max_len": 1024
            },
            "exec_id": {
              "type": "string",
              "max_len": 512
            },
            "start_time": {
              "type": "string",
              "max_len": 64
            },
            "uid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            }
          },
          "required": []
        },
        "operation": {
          "type": "string",
          "max_len": 32
        },
        "coverage": {
          "type": "string",
          "max_len": 128
        }
      },
      "required": [
        "process",
        "operation",
        "coverage"
      ]
    },
    "host.unusual_execution": {
      "type": "object",
      "fields": {
        "process": {
          "type": "object",
          "fields": {
            "pid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            },
            "path": {
              "type": "string",
              "max_len": 1024
            },
            "exec_id": {
              "type": "string",
              "max_len": 512
            },
            "start_time": {
              "type": "string",
              "max_len": 64
            },
            "uid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            }
          },
          "required": [
            "pid",
            "path"
          ]
        },
        "parent": {
          "type": "object",
          "fields": {
            "pid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            },
            "path": {
              "type": "string",
              "max_len": 1024
            },
            "exec_id": {
              "type": "string",
              "max_len": 512
            },
            "start_time": {
              "type": "string",
              "max_len": 64
            },
            "uid": {
              "type": "integer",
              "min": 0,
              "max": 4294967295
            }
          },
          "required": []
        },
        "unlinked": {
          "type": "boolean"
        }
      },
      "required": [
        "process",
        "unlinked"
      ]
    }
  }
}

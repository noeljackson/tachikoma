[Unit]
Description=Tachikoma approval control plane
Documentation=https://github.com/noeljackson/tachikoma

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
ExecStart=/usr/bin/env -i HOME=%h XDG_RUNTIME_DIR=%t PATH=/usr/local/bin:/usr/bin NOTIFY_SOCKET=${NOTIFY_SOCKET} %h/.local/bin/tachikomad
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target

[Unit]
Description=Tachikoma local proposal control plane
Documentation=https://github.com/noeljackson/tachikoma

[Service]
Type=simple
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=-%h/.config/tachikoma/ai.env
ExecStart=/usr/bin/env tachikomad
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target

[Unit]
Description=Tachikoma Slack approval transport
After=tachikoma.service
Wants=tachikoma.service
Conflicts=snitchgate-slack.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/env -i HOME=%h XDG_RUNTIME_DIR=%t PATH=/usr/local/bin:/usr/bin CREDENTIALS_DIRECTORY=%d %h/.local/bin/tachikoma-slack --socket %t/tachikoma/tachikoma.sock --credential %d/approval.token --bot-token-file %d/SLACK_BOT_TOKEN --app-token-file %d/SLACK_APP_TOKEN
LoadCredential=approval.token:%h/.config/tachikoma/credentials/slack-transport.token
LoadCredentialEncrypted=SLACK_BOT_TOKEN:%h/.config/tachikoma/credentials/SLACK_BOT_TOKEN.cred
LoadCredentialEncrypted=SLACK_APP_TOKEN:%h/.config/tachikoma/credentials/SLACK_APP_TOKEN.cred
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=default.target
